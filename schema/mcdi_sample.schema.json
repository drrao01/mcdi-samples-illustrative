{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mercor.com/schema/mcdi_sample.schema.json",
  "title": "MCDI eval sample",
  "type": "object",
  "required": ["sample_id", "name", "domain", "sample_type", "messages", "rubrics", "metadata"],
  "additionalProperties": false,
  "properties": {
    "sample_id": { "type": "string", "pattern": "^mcdi_[a-z0-9_]+$" },
    "name":      { "type": "string", "minLength": 1 },
    "domain":    { "enum": ["coding", "support", "finance", "shopping", "legal", "healthcare", "other"] },
    "sample_type": {
      "enum": ["representative", "loss_triggering", "flaky", "uncertified"],
      "description": "Assigned from measurement, not intent. 'uncertified' until the pass@k run lands."
    },
    "messages": {
      "type": "array", "minItems": 3,
      "items": { "$ref": "#/$defs/message" }
    },
    "rubrics": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/rubric" }
    },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "message": {
      "type": "object",
      "required": ["role"],
      "properties": {
        "role": { "enum": ["developer", "user", "assistant", "tool_declaration", "tool_call", "tool_response"] },
        "content": { "type": ["string", "null"] },
        "thought": { "type": "boolean", "description": "true when this assistant message is a thinking block" },
        "tool_description": { "type": "object", "description": "Gemini FunctionDeclaration" },
        "tool_name": { "type": "string" },
        "tool_call_id": { "type": "string" },
        "arguments": {},
        "_turn": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "rubric": {
      "type": "object",
      "required": ["id", "text", "check", "source", "num_turn", "expected_behavior", "overriden_by"],
      "additionalProperties": false,
      "properties": {
        "id":     { "type": "integer", "minimum": 0 },
        "text":   { "type": "string", "minLength": 1,
                    "description": "The instruction as written. Spec field. Drives provenance and supersession." },
        "check":  { "type": "string", "minLength": 1,
                    "description": "Mercor addition. The graded binary assertion; PASS always means correct behaviour." },
        "source": { "enum": ["SOURCE_DEVELOPER", "SOURCE_USER", "SOURCE_TOOL"] },
        "num_turn": { "type": "integer", "minimum": 0,
                      "description": "Turn the instruction ORIGINATED in, per the client spec. Not where it is graded." },
        "expected_behavior": { "enum": ["BEHAVIOR_SATISFIED", "BEHAVIOR_OVERRIDEN"] },
        "overriden_by": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "overriden_reason": {
          "enum": ["PROHIBITION", "PERMISSION", "SILENCE", "SPECIALIZATION", "ADVISORY", "RECENCY", null]
        },
        "_authoring_note": { "type": "string" }
      }
    }
  }
}
